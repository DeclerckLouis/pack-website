---
import BaseLayout from "@/layouts/BaseLayout.astro";
import CtaSection from "@/components/CtaSection.astro";
import Card from "@/components/Card.astro";
import Badge from "@/components/Badge.astro";
import Kicker from "@/components/Kicker.astro";
import Icon from "@/components/Icon.astro";
import Button from "@/components/Button.astro";
import Breadcrumbs from "@/components/Breadcrumbs.astro";
import Reviews from "@/components/Reviews.astro";
import Faq from "@/components/Faq.astro";
import { site } from "@/data/site";
import { service, breadcrumbs, faqPage } from "@/lib/schema";

// PRICING PAGE — three lanes: Beheer (per-module), Urenkaart (prepaid) and Los
// per uur. All prices excl. btw (B2B). Deliberately NO single big "anchor"
// bedrag at the top: the lowest entry per lane (€15/toestel, urenkaart, €60/u)
// is what carries. The €30/maand beheercontract-minimum is a sales/offerte rule
// and is intentionally kept off this public page.

// Beheer modules — chosen per kantoor, billed per toestel/gebruiker/locatie.
const modules: [string, string, string, string][] = [
  [
    "PacketFlow Secure",
    "toestel",
    "€15",
    "Automatische updates + EDR-beveiliging met 24/7 detectie en respons (Huntress). Op elk beheerd toestel — de basis.",
  ],
  [
    "PacketFlow Identity",
    "gebruiker",
    "€9",
    "Beveiliging van uw Microsoft 365-account: detectie van verdachte aanmeldingen, beheer van MFA en mailbeveiliging. Enkel voor Microsoft 365-klanten.",
  ],
  [
    "PacketFlow Backup – Microsoft 365",
    "gebruiker",
    "€6",
    "Back-up van e-mail, OneDrive, SharePoint en Teams. Getest, niet gehoopt.",
  ],
  [
    "PacketFlow Backup – Lokaal",
    "toestel",
    "€20",
    "Back-up van de gegevens die lokaal op uw toestel staan. 300 GB inbegrepen per toestel.",
  ],
  [
    "PacketFlow Network",
    "locatie",
    "€40",
    "Beheerde firewall, netwerkmonitoring en beheer van wifi en VLAN's.",
  ],
];

// The three entry points, surfaced high on the page as a lane picker — the
// lowest instap of each lane, not one headline bedrag.
const lanes: [string, string, string, string][] = [
  ["Beheer", "vanaf €15", "per toestel / maand", "#beheer"],
  ["Urenkaart", "€550", "voor 10 uur", "#urenkaart"],
  ["Los per uur", "€60", "per uur", "#los-per-uur"],
];

const crumbs: [string, string][] = [
  ["Home", "/"],
  ["Prijzen", "/prijzen"],
];

const faqs = [
  {
    question: "Moet ik een abonnement nemen?",
    answer:
      "Nee. U kiest zelf hoe u met mij werkt: losse hulp per uur, een urenkaart, of volledig beheer per module. Wat bij uw kantoor past, past.",
  },
  {
    question: "Wat is het verschil tussen een urenkaart en beheer?",
    answer:
      "Een urenkaart is hulp op afroep — u belt wanneer er iets is. Beheer betekent dat ik uw toestellen proactief bewaak, beveilig en up-to-date houd, zodat er minder misgaat. Veel klanten starten met een urenkaart en schakelen later over naar beheer.",
  },
  {
    question: "Ik heb maar één toestel. Heeft beheer dan zin?",
    answer:
      "Zeker. U kan enkel PacketFlow Secure nemen (€15/maand). Dan is uw toestel beveiligd en automatisch up-to-date, en de rest betaalt u per uur of met een urenkaart.",
  },
  {
    question: "Kan ik maandelijks opzeggen?",
    answer:
      "Ja, beheer is maandelijks opzegbaar, zonder langlopend contract. U betaalt alleen zolang u tevreden bent.",
  },
  {
    question: "Zijn de Microsoft 365-licenties inbegrepen?",
    answer:
      "De licenties reken ik apart aan, aan de normale Microsoft-prijs en als aparte lijn op uw factuur. Zo ziet u exact wat de licentie kost. Het opzetten, beveiligen en onderhouden zit wél in het beheer.",
  },
  {
    question: "Werk ik met een groter team?",
    answer:
      "De prijs per gebruiker en per toestel groeit gewoon mee. Voor grotere teams stel ik graag een voorstel op maat samen — bespreek het gerust.",
  },
];

const jsonLd = [
  service({
    name: "IT-beheer per module",
    description:
      "Beheerde IT per module voor kleine kantoren: beveiliging, Microsoft 365-bescherming, back-up en netwerk. Per toestel of per gebruiker, maandelijks opzegbaar vanaf €15 per toestel per maand.",
    serviceType: "Managed IT",
  }),
  service({
    name: "IT-support per uur en urenkaart",
    description:
      "Losse IT-hulp aan €60 per uur (excl. btw) of een prepaid urenkaart van 10 uur voor €550 (€55/u), 12 maanden geldig.",
    serviceType: "IT-support",
  }),
  breadcrumbs(crumbs),
  faqPage(faqs),
];
---

<BaseLayout
  title="Prijzen — IT-beheer, urenkaart of losse hulp"
  description="Heldere IT-prijzen: beheer vanaf €15/toestel/maand, een urenkaart van 10u voor €550, of losse hulp aan €60/u. Transparant, geen verrassingen."
  jsonLd={jsonLd}
>
  <section class="page-hero">
    <div class="container page-hero__in">
      <Breadcrumbs items={crumbs} />
      <Kicker>Prijzen</Kicker>
      <h1>Heldere prijzen, geen verrassingen</h1>
      <p class="lead page-hero__lead">
        Drie manieren om met Packetflow te werken — van losse hulp tot volledig
        beheer. U kiest wat bij uw kantoor past, en u weet vooraf exact waar u
        aan toe bent. Alle prijzen zijn excl. btw.
      </p>
      <div class="page-hero__actions">
        <Button href="/contact" variant="primary" iconRight="arrow-right">Plan een gesprek</Button>
        <Button href={site.phoneHref} variant="secondary" iconLeft="phone">Bel {site.phone}</Button>
      </div>

      <div class="lanes">
        {
          lanes.map(([name, amount, unit, anchor]) => (
            <a href={anchor} class="lane">
              <span class="lane__name">{name}</span>
              <span class="lane__amount">{amount}</span>
              <span class="lane__unit">{unit}</span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  {/* ---- Laan 1 — Beheer ---- */}
  <section class="section" id="beheer">
    <div class="container prijzen">
      <div class="section-head">
        <Kicker>Laan 1 — Beheer</Kicker>
        <h2>Beheer — uw IT volledig uit handen</h2>
        <p>
          Voor wie techniek liever niet meer ziet. U kiest per module wat u nodig
          heeft en betaalt per toestel of per gebruiker — geen groot pakket dat u
          half gebruikt. Vanaf <strong>€15 per toestel per maand</strong>,
          maandelijks opzegbaar.
        </p>
      </div>

      <div class="modules">
        <table class="modules__table">
          <thead>
            <tr>
              <th>Module</th>
              <th>Per</th>
              <th>Prijs / maand</th>
              <th>Wat het doet</th>
            </tr>
          </thead>
          <tbody>
            {
              modules.map(([name, per, price, what]) => (
                <tr>
                  <td class="modules__name">{name}</td>
                  <td>{per}</td>
                  <td class="modules__price">{price}</td>
                  <td class="modules__what">{what}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>

      {/* Mobile-friendly card list — mirrors the table above */}
      <div class="modules__cards">
        {
          modules.map(([name, per, price, what]) => (
            <Card class="module-card">
              <div class="module-card__head">
                <h3 class="module-card__name">{name}</h3>
                <span class="module-card__price">
                  {price}<span>/ maand · per {per}</span>
                </span>
              </div>
              <p class="module-card__what">{what}</p>
            </Card>
          ))
        }
      </div>

      <div class="examples">
        <div class="section-head section-head--tight">
          <Kicker>Twee voorbeelden om mee te starten</Kicker>
        </div>
        <div class="examples__grid">
          <Card class="example">
            <Badge tone="blue">Voorbeeld A — Werkplek</Badge>
            <p class="example__for">Voor wie lokaal werkt, met documenten op het toestel.</p>
            <p class="example__body">PacketFlow Secure + Lokale back-up, per toestel.</p>
            <p class="example__calc">
              Eén laptop → €15 + €20 = <strong>€35/maand</strong>.
            </p>
          </Card>
          <Card class="example">
            <Badge tone="blue">Voorbeeld B — 365</Badge>
            <p class="example__for">Voor wie in Microsoft 365 werkt, met bestanden in OneDrive/SharePoint.</p>
            <p class="example__body">
              PacketFlow Secure per toestel + Identity en Microsoft 365-back-up
              per gebruiker, eventueel aangevuld met Network per locatie.
            </p>
            <p class="example__calc">
              Twee gebruikers, drie toestellen → <strong>€75/maand</strong>.
            </p>
          </Card>
        </div>
      </div>

      <p class="prijzen__note">
        Microsoft 365-licenties staan apart en transparant op de factuur, aan de
        normale Microsoft-prijs. Het opzetten, beveiligen en onderhouden zit wél
        in de prijs. Beheer is maandelijks opzegbaar — geen langlopend contract.
        Beheerklanten hebben verplaatsing in zone 1 en 2 inbegrepen, zie de
        <a href="/tarieven">tarieven</a>.
      </p>
    </div>
  </section>

  {/* ---- Laan 2 — Urenkaart ---- */}
  <section class="section prijzen-band" id="urenkaart">
    <div class="container prijzen">
      <div class="prijzen-lane">
        <div>
          <Kicker>Laan 2 — Urenkaart</Kicker>
          <h2>Urenkaart — hulp wanneer u ze nodig heeft</h2>
          <p class="prijzen-lane__body">
            Geen abonnement, geen verplichting. Koop een blok uren vooraf en
            gebruik ze wanneer het uitkomt — handig voor wie af en toe hulp wil
            zonder vaste maandprijs.
          </p>
          <p class="prijzen-lane__body">
            Voordeliger dan het losse uurtarief, en u weet vooraf precies wat u
            betaalt. Ideaal om mee te starten; wilt u later toch alles uit handen
            geven, dan schakelt u eenvoudig over naar beheer.
          </p>
        </div>

        <Card raised class="urenkaart-card">
          <Badge tone="orange" dot>Prepaid</Badge>
          <div class="urenkaart-card__price">
            <span class="urenkaart-card__hours">10 uur</span>
            <span class="urenkaart-card__amount">€550</span>
          </div>
          <p class="urenkaart-card__unit">€55/u (excl. btw) · 12 maanden geldig</p>
          <Button href="/contact" variant="primary" size="lg" fullWidth iconRight="arrow-right">
            Vraag een urenkaart aan
          </Button>
        </Card>
      </div>
    </div>
  </section>

  {/* ---- Laan 3 — Los per uur ---- */}
  <section class="section" id="los-per-uur">
    <div class="container prijzen">
      <div class="section-head">
        <Kicker>Laan 3 — Losse hulp per uur</Kicker>
        <h2>Losse hulp per uur</h2>
        <p>
          <strong>€60/u</strong> (excl. btw). U betaalt enkel de tijd die ik
          effectief werk — geen abonnement, geen verborgen kosten.
        </p>
      </div>

      <ul class="checklist prijzen__list">
        <li>
          <span class="check"><Icon name="check" size={14} /></span>
          <span>Verplaatsing volgens zone vanuit {site.address.city} (zone 1 gratis). Een eerste kennismaking en het scoping-bezoek zijn altijd gratis.</span>
        </li>
        <li>
          <span class="check"><Icon name="check" size={14} /></span>
          <span>Projecten en installaties krijgen altijd een vaste prijs (forfait) na een gratis scoping-bezoek, zodat u vooraf weet wat het kost.</span>
        </li>
      </ul>

      <p class="prijzen__link">
        <a href="/tarieven">Bekijk de volledige tarieven en zones <Icon name="arrow-right" size={15} /></a>
      </p>
    </div>
  </section>

  <Reviews />

  <Faq items={faqs} />

  <CtaSection
    title="Niet zeker welke formule past?"
    body="Plan een gratis gesprek van 30 minuten — bij u of via telefoon. Dan bekijken we samen wat het beste bij uw kantoor past. Ik antwoord binnen één werkdag, vaak sneller."
  />
</BaseLayout>

<style>
  .prijzen {
    max-width: var(--container-md);
  }
  .section-head p {
    max-width: 60ch;
  }
  .section-head strong {
    color: var(--text-strong);
    font-weight: var(--fw-semibold);
  }

  /* Lane picker — the three entry points, high on the page */
  .lanes {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: var(--space-4);
    margin-top: var(--space-7);
  }
  .lane {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: var(--space-5);
    background: var(--surface-card);
    border: 1px solid var(--border-soft);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
    transition:
      border-color var(--dur-base) var(--ease-out),
      box-shadow var(--dur-base) var(--ease-out);
  }
  .lane:hover {
    border-color: var(--orange-300);
    box-shadow: var(--shadow-md);
  }
  .lane__name {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-muted);
  }
  .lane__amount {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-2xl);
    color: var(--text-strong);
    letter-spacing: -0.02em;
  }
  .lane__unit {
    font-size: var(--text-sm);
    color: var(--text-muted);
  }

  /* Beheer modules table */
  .modules {
    overflow-x: auto;
    margin-top: var(--space-6);
  }
  .modules__table {
    width: 100%;
    border-collapse: collapse;
  }
  .modules__table th,
  .modules__table td {
    text-align: left;
    padding: 14px 16px;
    border-bottom: 1px solid var(--border-soft);
    vertical-align: top;
  }
  .modules__table th {
    font-family: var(--font-sans);
    font-size: var(--text-sm);
    font-weight: var(--fw-semibold);
    color: var(--text-strong);
    white-space: nowrap;
  }
  .modules__table td {
    font-size: var(--text-sm);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
  }
  .modules__name {
    font-weight: var(--fw-semibold);
    color: var(--text-strong);
  }
  .modules__price {
    font-weight: var(--fw-semibold);
    color: var(--text-strong);
    white-space: nowrap;
  }
  .modules__what {
    min-width: 24ch;
  }

  /* Card variant of the modules — shown on narrow screens instead of the table */
  .modules__cards {
    display: none;
    flex-direction: column;
    gap: var(--space-3);
    margin-top: var(--space-6);
  }
  .module-card__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    flex-wrap: wrap;
  }
  .module-card__name {
    font-size: var(--text-md);
    margin: 0;
  }
  .module-card__price {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-lg);
    color: var(--text-strong);
    white-space: nowrap;
  }
  .module-card__price span {
    font-family: var(--font-sans);
    font-size: var(--text-xs);
    font-weight: var(--fw-regular);
    color: var(--text-muted);
    margin-left: 6px;
  }
  .module-card__what {
    margin: var(--space-3) 0 0;
    font-size: var(--text-sm);
    line-height: var(--leading-relaxed);
    color: var(--text-muted);
  }

  /* Two starter examples */
  .examples {
    margin-top: var(--space-8);
  }
  .section-head--tight {
    margin-bottom: var(--space-5);
  }
  .examples__grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: var(--space-5);
  }
  .example {
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
  }
  .example__for {
    margin: 0;
    font-size: var(--text-sm);
    color: var(--text-muted);
  }
  .example__body {
    margin: 0;
    font-size: var(--text-base);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
  }
  .example__calc {
    margin: auto 0 0;
    padding-top: var(--space-2);
    font-size: var(--text-base);
    color: var(--text-strong);
  }
  .example__calc strong {
    font-weight: var(--fw-semibold);
  }

  .prijzen__note {
    margin-top: var(--space-6);
    font-size: var(--text-sm);
    color: var(--text-muted);
    line-height: var(--leading-relaxed);
    max-width: 68ch;
  }
  .prijzen__note a {
    color: var(--text-link);
    text-decoration: underline;
  }

  /* Urenkaart lane */
  .prijzen-band {
    background: var(--paper);
    border-block: 1px solid var(--border-soft);
  }
  .prijzen-lane {
    display: grid;
    grid-template-columns: 1.2fr 0.8fr;
    gap: var(--space-7);
    align-items: center;
  }
  .prijzen-lane__body {
    font-size: var(--text-base);
    color: var(--text-body);
    line-height: var(--leading-relaxed);
    max-width: 56ch;
    margin: var(--space-3) 0 0;
  }
  .urenkaart-card {
    display: flex;
    flex-direction: column;
    gap: var(--space-4);
  }
  .urenkaart-card__price {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
  }
  .urenkaart-card__hours {
    font-family: var(--font-sans);
    font-size: var(--text-md);
    font-weight: var(--fw-semibold);
    color: var(--text-muted);
  }
  .urenkaart-card__amount {
    font-family: var(--font-display);
    font-weight: var(--fw-semibold);
    font-size: var(--text-3xl);
    color: var(--text-strong);
    letter-spacing: -0.02em;
  }
  .urenkaart-card__unit {
    font-size: var(--text-sm);
    color: var(--text-muted);
    margin: 0;
  }

  /* Los per uur */
  .prijzen__list {
    margin-top: var(--space-5);
    max-width: 64ch;
  }
  .prijzen__link {
    margin-top: var(--space-5);
  }
  .prijzen__link a {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-size: var(--text-sm);
    font-weight: var(--fw-medium);
    color: var(--primary);
  }

  /* keep in sync with --container-md in global.css */
  @media (max-width: 880px) {
    .lanes,
    .examples__grid,
    .prijzen-lane {
      grid-template-columns: 1fr;
    }
    .modules {
      display: none;
    }
    .modules__cards {
      display: flex;
    }
  }
</style>
